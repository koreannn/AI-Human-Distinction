# ============================================
# AI-Human-Distinction .gitignore
# ============================================

# Environment files (API keys)
.env
.env.local
.env.*.local
data_generation/.env

# Data files (too large for git)
*.csv
*.parquet
*.pkl
*.pickle
*.xlsx
data/

# Model checkpoints & outputs (large files)
*.pt
*.pth
*.ckpt
*.h5
*.bin
outputs/checkpoints/*
outputs/submissions/*
!outputs/checkpoints/.gitkeep
!outputs/submissions/.gitkeep

# Jupyter checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*.code-workspace

# Deprecated code
deprecated/

# Notes & temp files
note.py
note.ipynb
*.log

# Dev memos (local only)
devlog/
back_front.md
DATA_PATH_GUIDE.md
ITERATIVE_REFINEMENT_GUIDE.md
package-lock.json

# Presentation (too large)
presentation/
